{
  "name": "@destiny/duckdb-lake",
  "version": "0.1.0",
  "description": "Shared DuckDB connection + query builders for querying destiny data lake (Parquet on S3)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./connection": "./dist/connection.js",
    "./queries/equity": "./dist/queries/equity.js",
    "./queries/market": "./dist/queries/market.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.28.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^20.10.0",
    "typescript": "^7.0.2"
  }
}
