{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@repo/ui": ["../../packages/ui/src"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@destiny/duckdb-lake": ["../../packages/duckdb-lake/dist/index.js"],
      "@destiny/duckdb-lake/*": ["../../packages/duckdb-lake/dist/*"]
    }
  }
}
