# S3-compatible storage configuration
# For local development with Floci: use the values from `eval $(floci env)`
# For real AWS S3 / Cloudflare R2 / Backblaze B2: use those credentials

# S3 endpoint URL (localhost:4566 for Floci, or real S3 provider endpoint)
AWS_ENDPOINT_URL=http://localhost:4566

# S3 credentials (throwaway for Floci, real IAM keys for production)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS region (required by SDKs, value doesn't matter for Floci but matters for real S3)
AWS_REGION=us-east-1

# Lake configuration
LAKE_BUCKET=destiny-lake
LAKE_S3_USE_SSL=false
LAKE_S3_URL_STYLE=path

# DuckDB configuration
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
